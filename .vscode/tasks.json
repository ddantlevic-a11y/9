{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: clang++ build active file",
      "command": "/bin/bash",
      "args": [
        "-c",
        "if [[ \"${fileDirname}\" =~ \"9.1\" ]]; then /usr/bin/clang++ -std=c++17 -g \"${file}\" \"${fileDirname}/var.cpp\" \"${fileDirname}/dod.cpp\" \"${fileDirname}/sum.cpp\" -o \"${fileDirname}/${fileBasenameNoExtension}\"; else /usr/bin/clang++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\"; fi"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Збирання активного C++ файлу"
    }
  ]
}
